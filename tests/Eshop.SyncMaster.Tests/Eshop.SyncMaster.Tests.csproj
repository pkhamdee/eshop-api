<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Seam 2: one eshop-sync-master cycle against a real PostgreSQL and a real SQL Server (Testcontainers).
    SQL Server has no Arm image: CI runs these on an x86 runner (ubuntu-latest); on Apple Silicon Docker runs
    it under Rosetta.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Eshop.SyncMaster\Eshop.SyncMaster.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <!-- The mock Enterprise System's fake schema: this copy is the source of truth. pkhamdee/modernapp deploys the
         same file to the cluster's SQL Server (deploy/thirdparty/mssql), and its CI fails while the two differ. -->
    <None Include="enterprise-schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
